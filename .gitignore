# ==============================================================================
# .gitignore - Full Stack Java (Maven) + Angular Workspace
# ==============================================================================

# ------------------------------------------------------------------------------
# System & OS Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Eclipse
.metadata/
.classpath
.project
.settings/
.factorypath

# NetBeans
**/nbproject/private/
**/nbbuild/
**/dist/
**/nbdist/
**/.nb-gradle/

# ------------------------------------------------------------------------------
# Backend - Java / Maven (relative to backend/ folder)
# ------------------------------------------------------------------------------
**/backend/target/
**/backend/out/
backend/target/
backend/out/

# Maven release plugin
release.properties
pom.xml.releaseBackup
pom.xml.tag
pom.xml.next
pom.xml.patch
pom.xml.versionsBackup
dependency-reduced-pom.xml

# Log files
*.log
logs/
**/logs/

# ------------------------------------------------------------------------------
# Frontend - Angular / Node (relative to frontend/ folder)
# ------------------------------------------------------------------------------
**/frontend/node_modules/
**/frontend/.angular/
**/frontend/dist/
**/frontend/out-tsc/
**/frontend/tmp/
frontend/node_modules/
frontend/.angular/
frontend/dist/
frontend/out-tsc/
frontend/tmp/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cypress/Testing
**/frontend/cypress/screenshots/
**/frontend/cypress/videos/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# ------------------------------------------------------------------------------
# Agent & AI Tooling (Session files / logs)
# ------------------------------------------------------------------------------
.atl/

# ------------------------------------------------------------------------------
# Testing & Coverage (Vitest / Angular)
# ------------------------------------------------------------------------------
**/frontend/coverage/
frontend/coverage/

# ------------------------------------------------------------------------------
# Linters & Formatters
# ------------------------------------------------------------------------------
.eslintcache
.stylelintcache
.prettiercache

# ------------------------------------------------------------------------------
# Tools & Scripts temporary files
# ------------------------------------------------------------------------------
tools/*.tmp
tools/*.log
scripts/*.tmp
scripts/*.log

# Vite cache
**/frontend/.vite/
